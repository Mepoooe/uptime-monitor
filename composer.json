{
    "name": "app/uptime-monitor",
    "description": "Domain availability monitoring service",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/breeze": "^2.3",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.36",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"is_dir('public') || mkdir('public', 0777, true); is_dir('storage/app/public') || mkdir('storage/app/public', 0777, true); is_dir('storage/framework/views') || mkdir('storage/framework/views', 0777, true); is_dir('storage/framework/cache/data') || mkdir('storage/framework/cache/data', 0777, true); is_dir('storage/framework/sessions') || mkdir('storage/framework/sessions', 0777, true); is_dir('bootstrap/cache') || mkdir('bootstrap/cache', 0777, true);\"",
            "@php artisan storage:link --ansi > /dev/null 2>&1 || true"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": [
            "@php artisan test"
        ],
        "test:filter": [
            "@php artisan test --filter"
        ],
        "test:coverage": [
            "@php artisan test --coverage"
        ],
        "complete-update": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan optimize:clear",
            "@php artisan migrate",
            "php artisan responsecache:clear",
            "php artisan cache:clear"
        ],
        "complete-install": [
            "Composer\\Config::disableProcessTimeout",
            "php artisan migrate:fresh --ansi",
            "@complete-update"
        ],
        "pint": "XDEBUG_MODE=off php -dxdebug.mode=off ./vendor/bin/pint",
        "phpstan": "XDEBUG_MODE=off php -dxdebug.mode=off vendor/bin/phpstan analyse --no-interaction --error-format=table -c phpstan.neon"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
